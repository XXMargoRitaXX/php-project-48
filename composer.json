{
    "name": "hexlet/code",
    "bin": [
        "bin/gendiff"
    ],
    "description": "hexlet php-package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "XXMargoRitaXX"
        }
    ],
    "scripts": {
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit tests --coverage-text"
        ],
        "test-coverage-html": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit tests --coverage-html=coverage/html/"
        ],
        "test-coverage-xml": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit tests --coverage-clover=coverage/xml/clover.xml"
        ]
    },
    "autoload": {
        "files": [
            "src/Differ.php"
        ]
    },
    "require": {
        "docopt/docopt": "^1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^13.2"
    }
}
